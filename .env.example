# Copy to .env and fill in. Every value is optional: with nothing set the app runs fully offline
# in demo mode (sample disputes + rule-based analysis).

# --- AI provider ----------------------------------------------------------------
# Without any key the app uses its rule-based fallback instead of the AI agent.
#
# Option A (free): Google Gemini. Create a key at https://aistudio.google.com -> "Get API key".
# Defaults use the two Flash Lite models (separate 500-requests/day free quotas each).
# Run `python scripts/ai_check.py` to confirm the exact model IDs your key can use.
GEMINI_API_KEY=
# AI_MODEL=gemini-3.5-flash-lite
# AI_FALLBACK_MODEL=gemini-3.1-flash-lite
#
# Option B: any other OpenAI-compatible API (Groq, GitHub Models, OpenRouter, Ollama, ...)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=
# Optional: thinking effort for models that support it (low | medium | high)
# AI_REASONING_EFFORT=
# Investigations run at the same time (default 1 for free tiers' ~15 requests/minute)
# AI_CONCURRENCY=1
#
# Option C: Claude (paid API credits at console.anthropic.com). Used when set and no Gemini key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). Set to 0 to disable.
ANTHROPIC_FALLBACKS=1
# Caps Claude investigations per hour so a public demo URL can't run up your bill.
MAX_AI_RUNS_PER_HOUR=40

# --- PayPal (sandbox) ----------------------------------------------------------
# From https://developer.paypal.com/dashboard/applications/sandbox
# Leave empty to use the offline demo data instead of the real Disputes API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (for signature verification).
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Carrier tracking (optional) ------------------------------------------------
# EasyPost API key (a free TEST key starts with EZTK). PayPal stores tracking numbers but not
# carrier scans; with this set the agent pulls real scan events. In test mode the storefront ships
# with EasyPost's documented test code EZ4000000004 (= delivered).
EASYPOST_API_KEY=

# --- Alerts (optional) ----------------------------------------------------------
# Slack incoming-webhook URL or Zapier "Catch Hook" URL. Receives new disputes, verdicts and
# deadlines under 48h as JSON {"text": ..., "event": ..., ...}.
ALERT_WEBHOOK_URL=
# Assumed minutes to build one dispute case by hand, for the "time saved" estimate.
MINUTES_PER_CASE=45

# --- App -----------------------------------------------------------------------
MERCHANT_NAME=Kiln & Clay Studio
# Force demo mode even when PayPal credentials are present.
FORCE_MOCK=0
# When set, visitors can browse and run AI analysis, but submitting evidence, offers, accepting
# claims, settings and reset need this password. Recommended for a public demo URL.
DEMO_PASSWORD=
